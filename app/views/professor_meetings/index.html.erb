<section class="page-heading"><div><span class="eyebrow">MEMÓRIA DA ORIENTAÇÃO / ESPAÇO DOCENTE</span><h1>Reuniões e registros</h1><p>Retome conversas, revise os registros e acompanhe os próximos encontros.</p></div></section><% if @orientation %><div class="notice-box"><strong><%= date_text(@orientation.next_meeting_at,'%d %b %Y · %Hh%M') %> · <%= @orientation.student.name %></strong><p>Discussão do referencial teórico e do quadro piloto. Encontro online · Horário de Brasília.</p></div><div class="grid meeting-layout"><aside class="stack"><section class="card"><h2>Histórico · <%= @meetings.count %> encontros</h2><%= form_with url:professor_meetings_path,method: :get,class:'search-form' do %><%= hidden_field_tag :orientation,@orientation.id %><%= search_field_tag :q,params[:q],placeholder:'Buscar por pauta',class:'search-input',aria:{label:'Buscar reunião'} %><button type="submit" class="icon-button" aria-label="Pesquisar"><%= portal_icon(:search) %></button><% end %><div class="selection-list" style="margin-top:15px"><% @meetings.each do |meeting| %><%= link_to professor_meetings_path(meeting:meeting.id,orientation:@orientation.id),class:"selection-item #{'active' if @selected_meeting==meeting}" do %><small><%= date_text(meeting.held_at,'%d %b · %Hh%M') %></small><strong><%= meeting.title %></strong><span class="caption"><%= meeting.review_record&.status=='published' ? 'Registro validado' : 'Pendente de sua aprovação' %></span><% end %><% end %></div></section><section class="card"><h2>Agendar próximo encontro</h2><%= form_with model:@orientation do |f| %><div class="field"><%= f.label :next_meeting_at,'Data e horário' %><%= f.datetime_local_field :next_meeting_at %></div><%= f.submit 'Salvar agenda',class:'button small' %><% end %></section></aside><section class="stack"><% if (meeting=@selected_meeting) %><div class="card"><span class="eyebrow"><%= date_text(meeting.held_at,'%d %b %Y · %Hh%M') %></span><h2 class="record-title"><%= meeting.title %></h2><p class="caption"><%= @orientation.student.name %> · Profa. <%= current_professor.name %> · Prontuário v<%= meeting.review_record&.revision || 1 %></p><strong class="teal small"><%= meeting.review_record&.status=='published' ? 'Registro publicado após sua aprovação' : 'Reservado à orientadora' %></strong><p class="body-small" style="margin-top:18px"><%= meeting.review_record&.content&.fetch('summary',nil).presence || 'O registro ainda não tem resumo.' %></p><% if meeting.audio_file.attached? %><audio controls preload="none" src="<%= meeting_audio_path(meeting) %>" aria-label="Áudio original da orientação"></audio><% end %><h3>Síntese da edição docente</h3><p class="body-small muted"><%= meeting.review_record&.justification.presence || 'A proposta exige sua revisão antes de qualquer publicação.' %></p><% if meeting.review_record %><%= link_to 'Abrir validação docente',review_record_path(meeting.review_record),class:'button' %><% end %><div class="divider"></div><p class="caption">Consentimentos de gravação e envio externo são decisões diferentes.</p><%= link_to 'Consultar consentimentos',privacy_path(meeting:meeting.id,orientation:@orientation.id),class:'button small' %></div><% else %><section class="card empty-state">Nenhuma reunião nesta seleção.</section><% end %><section class="card"><h2>Conversas da orientação</h2><% @orientation.orientation_messages.order(:created_at).each do |message| %><div class="chat-message"><strong><%= message.author_name %> · <%= date_text(message.created_at,'%d %b, %Hh%M') %></strong><p><%= message.content %></p></div><% end %><%= form_with url:orientation_messages_path,style:'margin-top:15px' do %><%= hidden_field_tag :orientation_id,@orientation.id %><div class="field"><%= label_tag :content,'Mensagem à orientanda' %><%= text_area_tag :content,nil,required:true,maxlength:5000 %></div><%= submit_tag 'Enviar mensagem',class:'button small' %><% end %></section><details class="card"><summary>Registrar novo encontro</summary><%= form_with model:[@orientation,Meeting.new],style:'margin-top:15px' do |f| %><div class="field"><%= f.label :title,'Pauta' %><%= f.text_field :title,required:true %></div><div class="field"><%= f.label :held_at,'Data e horário' %><%= f.datetime_local_field :held_at,required:true %></div><div class="field"><%= f.label :audio_file,"Áudio da reunião (opcional, até 50 MB)" %><%= f.file_field :audio_file,accept:"audio/mpeg,audio/mp4,audio/wav,audio/ogg,audio/webm" %></div><div class="field"><%= f.label :summary,'Proposta de resumo' %><%= f.text_area :summary %></div><div class="field"><%= f.label :transcript,'Transcrição' %><%= f.text_area :transcript %></div><div class="field"><%= f.label :next_steps,'Encaminhamentos' %><%= f.text_area :next_steps %></div><%= f.submit 'Registrar para revisão',class:'button' %><% end %></details></section></div><% else %><div class="card empty-state"><h2>Seu espaço de reuniões começa aqui.</h2><%= link_to 'Cadastrar orientando',new_student_path,class:'button' %></div><% end %>
