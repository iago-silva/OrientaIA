<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title).presence || "#{current_user ? section_name : 'Bem-vindo'} · OrientaAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1b6c76">
    <meta name="application-name" content="OrientaAI">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "portal", defer: true %>
    <%= yield :head %>
  </head>
  <body class="<%= current_user ? 'workspace' : 'auth-body' %>">
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <% if current_user %>
      <aside class="sidebar" id="sidebar">
        <%= link_to root_path, class: "brand", aria: { label: "OrientaAI — início" } do %><%= portal_logo %><span>OrientaAI</span><% end %>
        <div class="workspace-card"><small><%= current_student ? 'MEU ESPAÇO ACADÊMICO' : 'ESPAÇO DA ORIENTADORA' %></small><strong>Mestrado em Educação</strong><span><%= current_student ? 'Turma 2025 · Pesquisa em curso' : "Profa. #{current_professor.name}" %></span></div>
        <nav class="side-nav" aria-label="<%= current_student ? 'Menu do aluno' : 'Menu da professora' %>">
          <% portal_navigation.each do |item| %>
            <%= link_to item[:locked] ? training_path : item[:path], class: "#{'active' if item[:active]} #{'locked' if item[:locked]}", aria: { current: item[:active] ? 'page' : nil } do %><%= portal_icon(item[:icon]) %><span><%= item[:label] %></span><% if item[:locked] %><%= portal_icon(:lock, class: "tiny") %><% end %><% end %>
          <% end %>
        </nav>
        <% if (student = focused_student) %><div class="sidebar-research"><small><%= current_student ? 'PESQUISA ATUAL' : 'ORIENTANDA EM FOCO' %></small><strong><%= current_student ? 'IA na formação docente' : student.name %></strong><span>Dissertação · Qualificação</span><div class="progress"><i style="width:<%= student.progress %>%"></i></div><span><%= (student.progress / 20.0).floor.clamp(0, 5) %> de 5 etapas concluídas</span></div><% end %>
        <div class="sidebar-bottom"><div class="critical-note"><%= portal_icon(:spark) %><strong>Seu olhar crítico importa.</strong><p>A IA apoia sua pesquisa. Avalie as sugestões com seu orientador.</p></div><%= link_to guide_path, class: "help-link" do %><%= portal_icon(:info) %>Ajuda e boas práticas<% end %></div>
      </aside>
      <div class="workspace-main">
        <header class="topbar"><div class="breadcrumbs"><button type="button" class="mobile-menu icon-button" data-sidebar-toggle aria-label="Abrir menu">☰</button><span><%= current_student ? 'Meu espaço' : 'Espaço da orientadora' %></span><b>›</b><strong><%= content_for(:section_name).presence || section_name %></strong></div><div class="account"><span class="badge neutral demo-label">Ambiente de demonstração</span><%= link_to current_student ? student_agenda_path : supervision_path, class: "icon-button", aria: { label: "Ver pendências" } do %><%= portal_icon(:bell) %><% end %><span class="avatar"><%= initials(current_user.name) %></span><details class="account-dropdown"><summary><%= current_user.name %> <span>⌄</span></summary><div><%= link_to "Privacidade", privacy_path %><%= link_to "Boas práticas", guide_path %><%= button_to "Sair da conta", logout_path, method: :delete %></div></details></div></header>
        <main id="main-content" class="page-content" tabindex="-1">
          <% if notice.present? %><div class="flash success" role="status"><%= portal_icon(:check) %><%= notice %></div><% end %>
          <% if alert.present? %><div class="flash warning" role="alert"><%= portal_icon(:info) %><%= alert %></div><% end %>
          <%= yield %>
        </main>
        <footer class="footer"><span>Dados e registros fictícios para demonstração.</span><span>OrientaAI · Apoio à pesquisa, com autonomia acadêmica</span></footer>
      </div>
    <% else %>
      <main id="main-content" class="auth-main">
        <% if notice.present? %><div class="flash success" role="status"><%= notice %></div><% end %><% if alert.present? %><div class="flash warning" role="alert"><%= alert %></div><% end %><%= yield %>
      </main>
    <% end %>
  </body>
</html>
