<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "PRODUC · Portal acadêmico" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="PRODUC">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag "produc-robot.png", type: "image/png" %>
    <%= stylesheet_link_tag "application", "produc", "data-turbo-track": "reload" %>
  </head>
  <body class="produc <%= current_user ? 'workspace-page' : 'authentication-page' %>">
    <% if current_user %>
      <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
      <div class="portal-shell <%= current_student ? 'student-portal' : 'professor-portal' %>">
        <header class="portal-header">
          <div class="portal-header-inner">
            <%= link_to root_path, class: "produc-brand", aria: { label: "PRODUC — início" } do %>
              <%= portal_icon(:robot, class: "produc-mascot") %><span>PRODUC</span>
            <% end %>
            <div class="portal-account">
              <span>Bem-vindo, <strong><%= current_user.name.split.first %></strong></span>
              <%= button_to "Sair", logout_path, method: :delete, class: "portal-logout" %>
              <span class="portal-user-icon"><%= portal_icon(:user) %></span>
            </div>
          </div>
        </header>
        <div class="portal-container">
          <nav class="portal-nav" aria-label="<%= current_student ? 'Menu do aluno' : 'Menu do professor' %>">
            <% portal_navigation.each do |item| %>
              <%= link_to item[:path], class: "portal-nav-link #{'is-active' if item[:active]}", aria: { current: item[:active] ? "page" : nil } do %>
                <%= portal_icon(item[:icon]) %><span><%= item[:label] %></span>
              <% end %>
            <% end %>
          </nav>
          <main id="main-content" class="portal-main <%= 'student-page' if current_student %>" tabindex="-1">
            <% if notice.present? %><div class="flash notice" role="status"><%= portal_icon(:check) %><%= notice %></div><% end %>
            <% if alert.present? %><div class="flash alert" role="alert"><%= alert %></div><% end %>
            <%= yield %>
          </main>
          <footer class="portal-footer"><span>PRODUC · <%= current_student ? 'Portal do Aluno' : 'Portal do Professor' %></span><span>Apoio à pesquisa e à orientação acadêmica</span></footer>
        </div>
      </div>
    <% else %>
      <% if notice.present? %><div class="flash notice auth-flash" role="status"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash alert auth-flash" role="alert"><%= alert %></div><% end %>
      <%= yield %>
    <% end %>
  </body>
</html>
