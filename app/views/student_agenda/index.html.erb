<section class="page-heading"><div><span class="eyebrow">AGENDA DA PESQUISA</span><h1>Um passo de cada vez.</h1><p>Organize entregas, reuniões e marcos importantes da sua pesquisa.</p></div><%= link_to 'Ver reuniões →',student_meetings_path,class:'button outline' %></section><div class="grid main-aside"><section class="card"><div class="card-heading"><h2>Plano de trabalho</h2><span class="badge"><%= @tasks.where.not(status:'completed').count %> em aberto</span></div><% @tasks.each do |task| %><div class="list-row"><span class="<%= task.status=='completed' ? 'teal' : 'muted' %>"><%= task.status=='completed' ? '✓' : '○' %></span><div><strong><%= task.title %></strong><p class="caption"><%= task.description %></p><small class="<%= task.due_on && task.due_on<Date.current && task.status!='completed' ? 'amber' : '' %>">Prazo: <%= date_text(task.due_on) %></small></div><% if task.status=='completed' %><span class="badge success">Concluída</span><% else %><%= button_to 'Concluir',student_task_path(task),method: :patch,params:{task:{status:'completed'}},class:'button outline small' %><% end %></div><% end %><% if @tasks.empty? %><p class="empty-state">Seu plano de trabalho está em dia.</p><% end %></section><aside class="card tint"><span class="eyebrow">PRÓXIMO ENCONTRO</span><h2 class="serif"><%= date_text(@orientation&.next_meeting_at,'%d %b · %Hh%M') %></h2><p class="caption">Com Profa. <%= current_student.professor.name %>. Retome os encaminhamentos publicados e prepare suas dúvidas.</p><%= link_to 'Abrir reuniões',student_meetings_path,class:'button small' %></aside></div>
