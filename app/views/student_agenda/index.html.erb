<% content_for :title, "Agenda · PRODUC" %>
<% content_for :section_name, "Agenda" %>
<section class="student-welcome compact-student-welcome"><div><span class="eyebrow student-eyebrow">AGENDA DA PESQUISA</span><h1>Um passo de cada vez.</h1><p>Organize entregas, reuniões e marcos importantes da sua pesquisa.</p></div><%= link_to "Ver reuniões →", student_meetings_path, class: "student-outline-button" %></section>
<div class="agenda-page-grid"><section class="student-card agenda-task-card"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">PRÓXIMOS PASSOS</span><h2>Plano de trabalho</h2></div><span class="tiny-count"><%= @tasks.where(status: %w[pending in_progress]).count %> em aberto</span></div>
  <% @tasks.each do |task| %><div class="agenda-task-row <%= task.status %>"><% if task.status == "completed" %><span class="task-complete-mark">✓</span><% else %><span class="task-radio"></span><% end %><div><strong><%= task.title %></strong><small><%= task.description %></small><span class="agenda-due <%= 'late' if task.due_on && task.due_on < Date.current && task.status != 'completed' %>"><%= task.due_on ? "Prazo: #{l(task.due_on, format: "%d de %B de %Y")}" : "Prazo a combinar" %></span></div><% if task.status != "completed" %><%= button_to "Concluir", student_task_path(task), method: :patch, params: { task: { status: "completed" } }, class: "student-small-action" %><% else %><span class="task-done-label">Concluída</span><% end %></div><% end %>
  <% if @tasks.empty? %><p class="student-empty">Nenhum próximo passo cadastrado.</p><% end %>
</section><aside class="agenda-aside"><section class="student-card upcoming-meeting-card"><span class="eyebrow student-eyebrow">PRÓXIMA ORIENTAÇÃO</span><% if @upcoming_meeting %><div class="agenda-date-large"><strong><%= l(@upcoming_meeting, format: "%d") %></strong><span><%= l(@upcoming_meeting, format: "%B").upcase %></span></div><p>Encontro com Profa. <%= @orientation&.professor&.name || "sua orientadora" %><br><strong><%= l(@upcoming_meeting, format: "%A · %H:%M") %></strong></p><%= link_to "Preparar pauta →", student_meetings_path, class: "student-text-link" %><% else %><p>Uma data ainda não foi combinada.</p><% end %></section><section class="student-card past-meetings-card"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">REGISTROS RECENTES</span><h2>Reuniões</h2></div><%= link_to "Todas →", student_meetings_path, class: "student-text-link" %></div><% @meetings.each do |meeting| %><%= link_to student_meetings_path(meeting: meeting.id), class: "mini-meeting-row" do %><span class="meeting-mark">▧</span><span><strong><%= meeting.title %></strong><small><%= l(meeting.held_at, format: "%d %b %Y") %></small></span><span>›</span><% end %><% end %></section></aside></div>
