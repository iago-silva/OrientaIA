<section class="page-heading"><div><span class="eyebrow">CHAMADA / DETALHES</span><h1><%= @opportunity.title %></h1><p><%= @opportunity.organization %></p></div><%= link_to 'Voltar',current_student ? opportunity_recommendations_path : students_path,class:'button outline' %></section><section class="card"><span class="badge warning">Confira a fonte oficial antes de submeter</span><h2 class="serif" style="margin-top:20px"><%= @opportunity.subject %></h2><p class="body-small"><%= @opportunity.description %></p><p>Prazo: <strong><%= date_text(@opportunity.deadline_on) %></strong></p><% if @opportunity.website.to_s.match?(/\Ahttps:\/\//) %><%= link_to 'Abrir fonte oficial ↗',@opportunity.website,target:'_blank',rel:'noopener noreferrer',class:'button' %><% else %><div class="notice-box cream">Edital demonstrativo. Nenhuma chamada externa foi vinculada; não há submissão real neste protótipo.</div><% end %></section>
