<section class="page-heading"><div><span class="eyebrow">CIRCULAÇÃO DO CONHECIMENTO</span><h1>Cadastrar chamada</h1><p>Registre as informações e confira sempre a fonte oficial.</p></div></section><section class="card" style="max-width:800px"><%= form_with model:@opportunity,url:opportunities_path do |f| %><% if @opportunity.errors.any? %><div class="form-errors" role="alert"><%= @opportunity.errors.full_messages.to_sentence %></div><% end %><% if current_professor %><div class="field"><%= label_tag :student_id,'Orientando' %><%= select_tag :student_id,options_from_collection_for_select(current_professor.students,:id,:name),required:true %></div><% end %><div class="field"><%= f.label :title,'Título da chamada' %><%= f.text_field :title,required:true %></div><div class="form-grid"><div class="field"><%= f.label :item_type,'Tipo' %><%= f.select :item_type,[['Periódico','journal'],['Congresso','congress'],['Evento','event']] %></div><div class="field"><%= f.label :deadline_on,'Prazo de submissão' %><%= f.date_field :deadline_on %></div></div><div class="field"><%= f.label :organization,'Organização / publicação' %><%= f.text_field :organization %></div><div class="field"><%= f.label :subject,'Tema' %><%= f.text_field :subject %></div><div class="field"><%= f.label :website,'Endereço da fonte oficial (https)' %><%= f.url_field :website %></div><div class="field"><%= f.label :description,'Descrição e regras' %><%= f.text_area :description,rows:5 %></div><%= f.submit 'Salvar chamada',class:'button' %><% end %></section>
