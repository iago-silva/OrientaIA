<section class="card" style="max-width:850px"><%= form_with model:@student do |f| %><% if @student.errors.any? %><div class="form-errors" role="alert"><%= @student.errors.full_messages.to_sentence %></div><% end %><div class="form-grid"><div class="field"><%= f.label :name,'Nome completo' %><%= f.text_field :name,required:true %></div><div class="field"><%= f.label :email,'E-mail de acesso' %><%= f.email_field :email,required:true %></div><div class="field"><%= f.label :program,'Programa' %><%= f.select :program,Student::PROGRAMS %></div><div class="field"><%= f.label :research_area,'Linha de pesquisa' %><%= f.text_field :research_area %></div><div class="field full"><%= f.label :project_title,'Título da pesquisa' %><%= f.text_field :project_title %></div><div class="field"><%= f.label :password,@student.persisted? ? 'Nova senha (opcional)' : 'Senha inicial de acesso' %><%= f.password_field :password,minlength:8,required:!@student.persisted?,autocomplete:'new-password' %></div><div class="field"><%= f.label :password_confirmation,'Confirmar senha' %><%= f.password_field :password_confirmation,autocomplete:'new-password' %></div><div class="field"><%= f.label :progress,'Progresso (%)' %><%= f.number_field :progress,min:0,max:100 %></div><div class="field"><%= f.label :active,'Situação' %><%= f.select :active,[['Ativo',true],['Arquivado',false]] %></div><% {research_problem:'Problema de pesquisa',objectives:'Objetivos',methodology:'Metodologia'}.each do |key,label| %><div class="field full"><%= f.label key,label %><%= f.text_area key,rows:3 %></div><% end %></div><p class="caption">Um novo aluno precisa concluir a formação inicial antes de acessar as páginas da pesquisa.</p><div class="button-row"><%= f.submit 'Salvar orientando',class:'button' %><%= link_to 'Cancelar',students_path,class:'button light' %></div><% end %></section>
