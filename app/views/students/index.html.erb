<% content_for :title, "Alunos · OrientaAI" %>
<section class="page-heading"><div><span class="eyebrow">GESTÃO DE ORIENTANDOS</span><h1>Alunos</h1><p>Acompanhe o percurso acadêmico do seu grupo de pesquisa.</p></div><%= link_to "+  Novo aluno", new_student_path, class: "button primary" %></section>
<section class="panel roster-panel"><div class="roster-summary"><div><strong><%= @students.count %></strong><span> alunos no seu grupo</span></div><div class="program-chips"><span class="status-pill active"><%= @students.where(active: true).count %> ativos</span><span class="status-pill neutral"><%= @students.where(active: false).count %> arquivados</span></div></div>
  <div class="table-wrap"><table class="data-table"><thead><tr><th>ESTUDANTE</th><th>PROGRAMA</th><th>PROJETO / ÁREA</th><th>PROGRESSO</th><th>STATUS</th><th></th></tr></thead><tbody>
    <% @students.each do |student| %><tr><td><%= link_to student.orientation ? orientation_path(student.orientation) : student_path(student), class: "table-person" do %><span class="avatar"><%= initials(student.name) %></span><span><strong><%= student.name %></strong><small><%= student.email %></small></span><% end %></td><td><span class="program-tag"><%= student.program %></span></td><td><strong class="project-title"><%= student.project_title.presence || "Projeto ainda não informado" %></strong><small class="table-sub"><%= student.research_area.presence || "Área a definir" %></small></td><td><div class="progress-wrap"><div class="progress-track"><span style="width: <%= student.progress %>%"></span></div><small><%= student.progress %>%</small></div></td><td><span class="status-pill <%= student.active? ? "active" : "neutral" %>"><i></i><%= student.active? ? "Ativo" : "Arquivado" %></span></td><td><%= link_to "Abrir →", student.orientation ? orientation_path(student.orientation) : student_path(student), class: "text-link" %></td></tr><% end %>
  </tbody></table></div>
  <% if @students.empty? %><div class="empty-state"><span>♙</span><strong>Seu grupo começa aqui</strong><p>Cadastre alunos para organizar projetos e orientações.</p><%= link_to "Cadastrar primeiro aluno", new_student_path, class: "button primary" %></div><% end %>
</section>
