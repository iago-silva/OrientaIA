<% content_for :title, "Alunos · PRODUC" %>
<section class="lavender-panel reference-page-panel">
  <div class="reference-page-heading"><div><h1>Alunos</h1><p>Acompanhe o desempenho dos seus orientandos.</p></div><%= link_to new_student_path, class: "insert-student" do %><%= portal_icon(:plus) %><span>Inserir aluno</span><% end %></div>
  <div class="reference-students">
    <% @students.each do |student| %>
      <article class="reference-student-card">
        <div class="reference-student-info"><h2><%= student.name %> <span>· <%= student.program %></span></h2><p><%= student.project_title.presence || "Projeto ainda não informado" %></p><small><%= student.active? ? "Aluno ativo" : "Aluno arquivado" %> · Atualizado em <%= l(student.updated_at, format: "%d/%m/%Y") %></small></div>
        <div class="reference-performance"><span>Desempenho:</span><strong><%= student.progress %>%</strong></div>
        <%= link_to student.orientation ? orientation_path(student.orientation) : student_path(student), class: "button orange-button" do %><%= portal_icon(:document) %>Ver detalhes<% end %>
      </article>
    <% end %>
    <% if @students.empty? %><div class="empty-state"><%= portal_icon(:users) %><strong>Seu grupo começa aqui</strong><p>Cadastre alunos para organizar projetos e orientações.</p><%= link_to "Cadastrar primeiro aluno", new_student_path, class: "button orange-button" %></div><% end %>
  </div>
</section>
