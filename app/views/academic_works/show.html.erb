<% content_for :title, "Revisão · #{@work.title} · OrientaAI" %>
<% content_for :section_name, "Trabalhos / Revisão" %>
<section class="work-toolbar"><div><%= link_to "← Trabalhos", academic_works_path, class: "student-back-link" %><h1><%= @work.title %></h1><p>Versão <%= @version&.version_number || @work.current_version %> · <%= @work.manuscript.to_s.lines.count %> linhas de prévia · Atualizado em <%= l(@work.updated_at, format: "%d %b %Y · %H:%M") %></p></div><div class="work-toolbar-actions"><%= link_to "Exportar orientações", academic_work_path(@work, format: :html), class: "student-outline-button" %><span class="comment-count"><%= @work.review_comments.where(status: "open").count %> não resolvidas</span></div></section>
<div class="review-workspace">
  <section class="manuscript-panel"><div class="manuscript-toolbar"><span>⌕</span><span><%= @work.title %></span><span class="paper-page">Versão <%= @version&.version_number || @work.current_version %></span><span class="zoom-label">100%</span><span>＋</span></div>
    <% if @version&.file&.attached? && @version.file.content_type == "application/pdf" %><iframe class="document-pdf-preview" src="<%= rails_blob_path(@version.file, disposition: "inline") %>" title="Prévia do documento PDF"></iframe>
    <% elsif @version&.file&.attached? %><div class="document-file-preview"><span class="document-glyph">▤</span><h2>Arquivo enviado para revisão</h2><p>O arquivo Word foi salvo. Baixe-o para visualizar o conteúdo nesta demonstração.</p><%= link_to "Baixar documento", rails_blob_path(@version.file, disposition: "attachment"), class: "student-outline-button" %></div>
    <% else %><div class="paper-preview"><div class="paper-heading"><small>MESTRADO EM EDUCAÇÃO · VERSÃO <%= @version&.version_number || @work.current_version %></small><h2><%= @work.title %></h2><span>Marina Costa · <%= l((@version&.created_at || @work.updated_at).to_date, format: "%d de %B de %Y") %></span></div><% @work.manuscript.to_s.split("\n\n").each_with_index do |paragraph, index| %><% if index == 1 && @work.review_comments.any? %><p class="annotated-paragraph"><%= paragraph %><sup>1</sup></p><% else %><p><%= paragraph %></p><% end %><% end %><div class="paper-reference"><strong>Referências</strong><p>FREIRE, P. <em>Pedagogia da autonomia</em>. São Paulo: Paz e Terra, 1996.</p><p>SELWYN, N. <em>Education and Technology</em>. London: Bloomsbury, 2016.</p></div></div><% end %>
    <div class="paper-bottom"><span><%= @version&.file&.attached? ? "Documento armazenado na biblioteca da pesquisa." : "Prévia textual ilustrativa · envie sua versão para armazenar o arquivo." %></span><span>‹ Versão anterior&nbsp;&nbsp; Próxima versão ›</span></div></section>
  <aside class="review-comments-panel"><div class="review-panel-head"><div><span class="eyebrow student-eyebrow">ORIENTAÇÕES DA ORIENTADORA</span><h2>Amplie o conceito de letramento</h2></div><span class="comment-bubble"><%= @work.review_comments.count %></span></div><div class="review-filter"><span class="filter-chip active">Não resolvidas (<%= @work.review_comments.where(status: "open").count %>)</span><span class="filter-chip">Todas (<%= @work.review_comments.count %>)</span></div>
    <% @work.review_comments.each do |comment| %><article class="review-comment <%= comment.status %>"><div class="comment-meta"><span class="comment-number"><%= comment.status == "resolved" ? "✓" : "↳" %></span><div><strong><%= comment.section.presence || "Comentário de leitura" %></strong><small><%= comment.author_name %> · <%= l(comment.created_at, format: "%d %b · %H:%M") %></small></div></div><blockquote><%= comment.anchor_text %></blockquote><p><%= comment.content %></p><% if comment.status == "open" %><%= button_to "Marcar como revisada", academic_work_review_comment_path(@work, comment), method: :patch, class: "resolve-comment-button" %><% else %><span class="resolved-label">✓ Revisada</span><% end %></article><% end %>
    <div class="reply-box"><span class="eyebrow">RESPONDER À ORIENTADORA</span><%= form_with model: [@work, @reply], class: "reply-form" do |form| %><%= form.text_area :content, rows: 3, placeholder: "Escreva uma dúvida ou resposta...", required: true %><%= form.submit "Enviar comentário", class: "button teal-button small-button" %><% end %></div>
  </aside>
</div>
