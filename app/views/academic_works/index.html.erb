<% content_for :title, "Trabalhos · PRODUC" %>
<% content_for :section_name, "Trabalhos" %>
<section class="student-welcome compact-student-welcome"><div><span class="eyebrow student-eyebrow">BIBLIOTECA DA PESQUISA</span><h1>Cada versão, uma evolução.</h1><p>Envie seus textos, acompanhe revisões e mantenha o percurso da escrita organizado.</p></div><span class="work-count-badge"><%= @works.count %> documentos</span></section>
<div class="works-library-layout">
  <aside class="student-card document-list-card"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">MEUS DOCUMENTOS</span><h2>Biblioteca</h2></div><span class="tiny-count"><%= @works.count %></span></div>
    <% @works.each do |work| %><%= link_to academic_work_path(work), class: "library-work-row #{'selected' if @selected_work == work}" do %><span class="document-glyph">▤</span><span><strong><%= work.title %></strong><small><%= work.category %> · <%= work.work_versions.count %> versões</small></span><span class="row-arrow">›</span><% end %><% end %>
    <div class="library-tip"><span>✳</span><p>Guarde uma nova versão sempre que fizer mudanças relevantes. Assim fica mais fácil acompanhar sua evolução.</p></div>
  </aside>
  <div class="library-main-column">
    <% if @selected_work %>
      <section class="student-card upload-work-card"><div class="upload-work-header"><div><span class="eyebrow student-eyebrow">ENVIAR NOVA VERSÃO</span><h2>Continue de onde parou.</h2><p>PDF ou Word · A versão anterior continua guardada.</p></div><span class="upload-symbol">↑</span></div>
        <%= form_with model: [@selected_work, @new_version], class: "version-upload-form" do |form| %><%= form.file_field :file, accept: ".pdf,.doc,.docx", class: "file-input", required: true %><div class="upload-drop"><span class="upload-file-icon">▧</span><div><strong>Adicione seu documento: <label for="work_version_file">selecione um arquivo</label></strong><small>PDF ou DOCX · até 20 MB</small></div></div><div class="field"><%= form.label :change_note, "O que mudou nesta versão?" %><%= form.text_field :change_note, placeholder: "Ex.: reescrevi a seção 2.2 e respondi aos comentários" %></div><%= form.submit "Enviar para revisão", class: "button teal-button" %><% end %>
      </section>
      <section class="student-card version-history-card"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">HISTÓRICO DE VERSÕES</span><h2><%= @selected_work.title %></h2></div><%= link_to "Abrir documento →", academic_work_path(@selected_work), class: "student-text-link" %></div><div class="version-table"><% @selected_work.work_versions.each do |version| %><div class="version-row"><span class="version-number">V<%= version.version_number %></span><div><strong><%= version.label %></strong><small><%= l(version.created_at, format: "%d %b %Y · %H:%M") %> · <%= version.change_note.presence || "Sem nota da versão" %></small></div><span class="version-state <%= version.status %>"><%= version.status == "revision_requested" ? "Revisão disponível" : (version.status == "approved" ? "Aprovado" : "Recebido") %></span><% if version.file.attached? %><%= link_to "↓", rails_blob_path(version.file, disposition: "attachment"), class: "download-version", aria: { label: "Baixar versão" } %><% end %></div><% end %></div></section>
    <% else %><section class="student-card student-empty-card"><span>▤</span><h2>Sua biblioteca começa aqui</h2><p>Cadastre ou envie um trabalho para acompanhar as versões.</p></section><% end %>
  </div>
  <aside class="student-ai-reading"><span class="ai-star">✳</span><span class="eyebrow">LEITURA ASSISTIDA</span><h2>Uma leitura atenta do seu texto</h2><p>Ao enviar, você pode consultar sugestões de clareza, estrutura e adequação acadêmica. Elas são pontos para revisar, não uma avaliação final.</p><div class="ai-reading-rule"></div><strong>Antes de enviar</strong><ul><li>Confira se esta é a versão correta.</li><li>Remova dados que não devem circular.</li><li>Converse com sua orientadora sobre dúvidas.</li></ul><%= link_to "Ver análise ABNT →", abnt_analysis_path, class: "student-text-link" %></aside>
</div>
