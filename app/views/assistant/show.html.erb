<% content_for :title, "Chat IA · PRODUC" %>
<section class="lavender-panel reference-page-panel chat-page">
  <div class="reference-page-heading"><div><h1>Chat IA</h1><p>Assistente IA para <%= current_student ? 'apoiar sua pesquisa de pós-graduação' : 'professores de pós-graduação' %>.</p></div><span class="chat-demo-badge">Demonstração</span></div>
  <p class="chat-help">Um espaço para sugestões e atividades da sua pesquisa.</p>
  <div class="chat-conversation">
    <div class="chat-greeting"><%= portal_icon(:robot) %><p>Olá! Sou seu assistente acadêmico.<br><span>O chat será disponibilizado quando a integração com IA estiver conectada.</span></p></div>
    <div class="chat-shortcuts">
      <%= link_to current_student ? student_agenda_path : orientations_path do %><%= portal_icon(:calendar) %>Organizar próximos passos<% end %>
      <%= link_to current_student ? academic_works_path : students_path do %><%= portal_icon(:book) %><%= current_student ? 'Acompanhar meus trabalhos' : 'Acompanhar meus alunos' %><% end %>
    </div>
  </div>
  <div class="chat-composer"><label class="visually-hidden" for="chat-message">Mensagem para o assistente</label><textarea id="chat-message" rows="4" placeholder="Em breve, envie suas perguntas por aqui…" disabled aria-describedby="chat-availability"></textarea><div class="chat-composer-actions"><p id="chat-availability">Integração com IA em desenvolvimento.</p><button class="button primary" type="button" disabled><%= portal_icon(:send) %>Enviar</button></div></div>
  <% if current_professor %><details class="robot-integration"><summary>Integração do robô · documentação da API <span aria-hidden="true">↗</span></summary><%= render "integration" %></details><% end %>
</section>
