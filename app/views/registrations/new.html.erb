<% content_for :title, "Cadastro · OrientaAI" %>
<section class="auth-card signup-card"><%= link_to login_path, class: "brand" do %><%= portal_logo %>OrientaAI<% end %><h2>Seu espaço de orientação.</h2><p class="muted small">Crie seu cadastro de professor. Seus orientandos serão vinculados ao seu espaço.</p><%= form_with model: @professor, url: signup_path do |f| %><% if @professor.errors.any? %><div class="form-errors" role="alert"><%= @professor.errors.full_messages.to_sentence %></div><% end %><div class="field"><%= f.label :name, "Nome completo" %><%= f.text_field :name, required: true, autocomplete: "name" %></div><div class="field"><%= f.label :email, "E-mail" %><%= f.email_field :email, required: true, autocomplete: "email" %></div><div class="field"><%= f.label :institution, "Instituição" %><%= f.text_field :institution, autocomplete: "organization" %></div><div class="field"><%= f.label :password, "Senha" %><%= f.password_field :password, minlength: 8, required: true, autocomplete: "new-password" %></div><div class="field"><%= f.label :password_confirmation, "Confirmar senha" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div><%= f.submit "Criar meu espaço", class: "button" %><% end %><p class="auth-switch">Já tem conta? <%= link_to "Entre aqui", login_path %></p></section>
