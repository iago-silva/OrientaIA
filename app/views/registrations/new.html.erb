<% content_for :title, "Criar conta · OrientaAI" %>
<div class="auth-page">
  <section class="auth-intro">
    <%= link_to login_path, class: "brand brand-light" do %><span class="brand-mark">O</span><span>OrientaAI<small>PORTAL ACADÊMICO</small></span><% end %>
    <div class="auth-copy"><span class="eyebrow light">SEU ESPAÇO DE ORIENTAÇÃO</span><h1>Organize o percurso<br><em>de cada pesquisa.</em></h1><p>Cadastre sua conta para conhecer o protótipo do portal de acompanhamento acadêmico.</p></div>
    <div class="auth-foot">OrientaAI <span>·</span> Apoio à pesquisa, com autonomia acadêmica</div>
  </section>
  <section class="auth-panel-wrap"><div class="auth-panel">
    <div class="auth-logo"><span class="brand-mark">O</span><strong>OrientaAI</strong></div>
    <span class="eyebrow">COMECE POR AQUI</span><h2>Crie sua conta</h2><p class="muted">Leva menos de um minuto.</p>
    <%= form_with model: @professor, url: signup_path, class: "form-stack" do |form| %>
      <% if @professor.errors.any? %><div class="form-errors"><%= @professor.errors.full_messages.to_sentence %></div><% end %>
      <div class="field"><%= form.label :name, "Nome completo" %><%= form.text_field :name, placeholder: "Seu nome", required: true %></div>
      <div class="field"><%= form.label :email, "E-mail" %><%= form.email_field :email, placeholder: "voce@universidade.br", required: true %></div>
      <div class="field"><%= form.label :institution, "Instituição" %><%= form.text_field :institution, placeholder: "Universidade ou programa" %></div>
      <div class="field"><%= form.label :password, "Senha" %><%= form.password_field :password, minlength: 8, required: true %></div>
      <div class="field"><%= form.label :password_confirmation, "Confirme a senha" %><%= form.password_field :password_confirmation, required: true %></div>
      <%= form.submit "Criar conta", class: "button primary full" %>
    <% end %>
    <p class="auth-switch">Já tem uma conta? <%= link_to "Entrar", login_path %></p>
  </div></section>
</div>
