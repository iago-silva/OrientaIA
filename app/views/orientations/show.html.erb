<section class="page-heading"><div><span class="eyebrow">ORIENTAÇÃO / <%= @orientation.student.program %></span><h1><%= @orientation.student.name %></h1><p><%= @orientation.title %></p></div><%= link_to 'Editar orientando',edit_student_path(@orientation.student),class:'button outline' %></section><div class="grid main-aside"><section class="stack"><section class="card"><h2>Contexto da pesquisa</h2><% {research_problem:'Problema de pesquisa',objectives:'Objetivos',methodology:'Metodologia'}.each do |key,label| %><h3><%= label %></h3><p class="body-small muted"><%= @orientation.student.public_send(key).presence || 'Ainda não informado.' %></p><% end %></section><section class="card"><h2>Tarefas da orientação</h2><% @tasks.each do |task| %><div class="list-row"><div><strong><%= task.title %></strong><small><%= date_text(task.due_on) %> · <%= task.description %></small></div><% if task.status!='completed' %><%= button_to 'Concluir',orientation_task_path(@orientation,task),method: :patch,params:{task:{status:'completed'}},class:'button light small' %><% else %><span class="badge success">Concluída</span><% end %></div><% end %><%= form_with model:Task.new,url:orientation_tasks_path(@orientation),style:'margin-top:20px' do |f| %><div class="field"><%= f.label :title,'Nova tarefa' %><%= f.text_field :title,required:true %></div><div class="field"><%= f.label :due_on,'Prazo' %><%= f.date_field :due_on %></div><%= f.submit 'Adicionar tarefa',class:'button small' %><% end %></section><section class="card"><h2>Devolutivas docentes</h2><% @feedbacks.each do |feedback| %><p class="body-small"><strong><%= feedback.author_name %></strong> · <%= feedback.content %></p><% end %><%= form_with model:Feedback.new,url:orientation_feedbacks_path(@orientation) do |f| %><div class="field"><%= f.label :content,'Nova devolutiva' %><%= f.text_area :content,required:true %></div><%= f.submit 'Salvar para revisão',class:'button small' %><% end %></section></section><aside class="stack"><section class="card"><h2>Próximo encontro</h2><%= form_with model:@orientation do |f| %><div class="field"><%= f.label :next_meeting_at,'Data e horário' %><%= f.datetime_local_field :next_meeting_at %></div><div class="field"><%= f.label :notes,'Anotações da orientação' %><%= f.text_area :notes %></div><%= f.submit 'Salvar agenda',class:'button' %><% end %></section><%= link_to 'Reuniões e registros →',professor_meetings_path(orientation:@orientation.id),class:'button outline' %><%= link_to 'Validação docente →',supervision_path,class:'button outline' %></aside></div>
