<section class="page-heading"><div><span class="eyebrow">ACOMPANHAMENTO ACADÊMICO</span><h1>Orientações</h1><p>Projetos, tarefas e próximos passos do seu grupo.</p></div><%= link_to 'Ver orientandos',students_path,class:'button outline' %></section><div class="grid grid-2"><% @orientations.each do |orientation| %><section class="card"><span class="badge"><%= formatted_status(orientation.status) %></span><h2 class="serif" style="margin-top:16px"><%= orientation.student.name %></h2><p class="body-small"><%= orientation.title %></p><p class="caption">Próximo encontro: <%= date_text(orientation.next_meeting_at,'%d %b · %Hh%M') %></p><%= link_to 'Abrir acompanhamento',orientation_path(orientation),class:'button' %></section><% end %></div>
