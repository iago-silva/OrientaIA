<% content_for :title, "Orientações · PRODUC" %>
<section class="lavender-panel reference-page-panel">
  <div class="reference-page-heading"><div><h1>Gerencie suas orientações</h1><p>Crie, edite e organize suas orientações.</p></div></div>
  <div class="reference-orientation-groups">
    <% [["Mestrandos", "Mestrado"], ["Doutorandos", "Doutorado"]].each do |label, program| %>
      <% group = @orientations.select { |orientation| orientation.student.program == program } %>
      <details class="orientation-group">
        <summary><span><%= label %></span><span class="button orange-button"><%= portal_icon(:edit) %>Editar</span></summary>
        <div class="orientation-group-content">
          <% group.each do |orientation| %>
            <%= link_to orientation_path(orientation), class: "group-student-link" do %><div><strong><%= orientation.student.name %></strong><small><%= orientation.title %></small></div><span class="status-pill <%= orientation.status %>"><%= formatted_status(orientation.status) %></span><span aria-hidden="true">→</span><% end %>
          <% end %>
          <% if group.empty? %><p class="group-empty">Nenhuma orientação de <%= program.downcase %> cadastrada.</p><% end %>
          <%= link_to "＋ Cadastrar aluno", new_student_path, class: "text-link" %>
        </div>
      </details>
    <% end %>
  </div>
</section>
