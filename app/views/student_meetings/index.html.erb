<% content_for :title, "Reuniões · PRODUC" %>
<% content_for :section_name, "Reuniões" %>
<section class="student-welcome compact-student-welcome"><div><span class="eyebrow student-eyebrow">MEMÓRIA DA ORIENTAÇÃO</span><h1>Cada conversa, um caminho registrado.</h1><p>Reúna transcrições, resumos e encaminhamentos em um só lugar.</p></div><a class="button teal-button" href="#new-meeting">＋ Registrar reunião</a></section>
<div class="meeting-context-bar"><span class="meeting-context-icon">▧</span><div><strong><%= current_student.name %> · Profa. <%= @orientation&.professor&.name || "orientadora" %></strong><small><%= current_student.program %> · Histórico compartilhado de orientação</small></div><span><%= @meetings.count %> reuniões</span><span><%= @meetings.sum { |meeting| meeting.transcript.to_s.lines.count } %> transcrições</span></div>
<div class="meetings-workspace">
  <aside class="student-card meeting-history"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">HISTÓRICO DE REUNIÕES</span><h2>Conversas da orientação</h2></div><span class="tiny-count"><%= @meetings.count %></span></div><%= form_with url: student_meetings_path, method: :get, class: "meeting-search" do |form| %><span>⌕</span><%= form.search_field :q, value: params[:q], placeholder: "Buscar por assunto ou data", aria: { label: "Buscar reuniões" } %><%= form.submit "Buscar" %><% end %><div class="meeting-filters"><%= link_to "Todas", student_meetings_path, class: "filter-chip #{'active' if params[:q].blank?}" %><span class="filter-chip">Este semestre</span></div>
    <% @meetings.each do |meeting| %><div class="history-meeting <%= 'selected' if @selected_meeting == meeting %>"><%= link_to student_meetings_path(meeting: meeting.id), class: "history-meeting-link" do %><small><%= l(meeting.held_at, format: "%d %b %Y · %H:%M").upcase %></small><strong><%= meeting.title %></strong><span><%= truncate(meeting.summary, length: 88) %></span><i><%= meeting.transcript.to_s.lines.count %> intervenções · <%= meeting.source == "robot" ? "Registro do robô" : "Registro de orientação" %></i><% end %></div><% end %>
    <section class="quick-meeting-form" id="new-meeting"><span class="eyebrow student-eyebrow">NOVO REGISTRO</span><h3>Adicionar reunião</h3><%= form_with model: @meeting, url: student_meetings_path, class: "form-stack small-stack" do |form| %><div class="field"><%= form.label :title, "Assunto" %><%= form.text_field :title, required: true, placeholder: "Assunto da conversa" %></div><div class="field"><%= form.label :held_at, "Data e hora" %><%= form.datetime_local_field :held_at, required: true %></div><div class="field"><%= form.label :transcript, "Transcrição ou anotações" %><%= form.text_area :transcript, rows: 3 %></div><div class="field"><%= form.label :summary, "Resumo" %><%= form.text_area :summary, rows: 2 %></div><div class="field"><%= form.label :next_steps, "Encaminhamentos" %><%= form.text_area :next_steps, rows: 2 %></div><div class="field"><%= form.label :audio_file, "Áudio (opcional)" %><%= form.file_field :audio_file, accept: "audio/*" %></div><%= form.submit "Salvar registro", class: "button teal-button full" %><% end %></section>
  </aside>
  <section class="student-card meeting-detail"><% if @selected_meeting %><div class="meeting-detail-head"><div><span class="eyebrow student-eyebrow">TRANSCRIÇÃO DA REUNIÃO</span><h2><%= @selected_meeting.title %></h2><p><%= l(@selected_meeting.held_at, format: "%d %b %Y · %H:%M") %> · Profa. <%= @orientation&.professor&.name || "orientadora" %></p></div><span class="meeting-status">Concluída · Anotada</span></div>
      <% if @selected_meeting.audio_file.attached? %><div class="audio-player"><audio controls preload="metadata"><source src="<%= url_for(@selected_meeting.audio_file) %>"></audio></div><% end %>
      <div class="transcript-content"><% @selected_meeting.transcript.to_s.lines.each do |line| %><% speaker, words = line.split(":", 2) %><div class="transcript-line"><span class="transcript-avatar"><%= initials(speaker.presence || "MC") %></span><div><strong><%= speaker.presence || "Registro" %></strong><p><%= words.presence || line %></p></div></div><% end %></div>
      <div class="transcript-actions"><span><%= @selected_meeting.transcript.to_s.lines.count %> intervenções · Texto salvo na memória da orientação</span><%= link_to "Ver todas as reuniões →", student_meetings_path, class: "student-text-link" %></div>
    <% else %><div class="student-empty"><h2>Nenhuma conversa registrada</h2><p>Adicione uma reunião para começar a criar a memória da orientação.</p></div><% end %></section>
  <aside class="meeting-summary-column"><section class="student-card meeting-ai-summary"><div class="student-card-heading"><div><span class="eyebrow student-eyebrow">RESUMO DA REUNIÃO</span><h2>O que conversamos</h2></div><span class="ai-star">✳</span></div><% if @selected_meeting %><p><%= @selected_meeting.summary %></p><div class="summary-scope-note">Resumo de demonstração para o protótipo. Registros reais precisam ser produzidos e conferidos no fluxo final.</div><div class="meeting-followups"><span class="eyebrow student-eyebrow">ENCAMINHAMENTOS</span><% @selected_meeting.next_steps.to_s.split(";").each do |step| %><div><span class="task-radio"></span><p><%= step.strip %></p></div><% end %></div><% end %></section><section class="meeting-related-work"><span class="eyebrow">DOCUMENTO RELACIONADO</span><%= link_to @student_work ? @student_work.title : "Ver trabalhos da pesquisa", @student_work ? academic_work_path(@student_work) : academic_works_path %><small>Versão atual · comentário em aberto</small></section></aside>
</div>
