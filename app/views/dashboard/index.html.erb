<% content_for :title, "Dashboard · PRODUC" %>
<h1 class="visually-hidden">Dashboard do professor</h1>
<section class="portal-stats" aria-label="Resumo das orientações">
  <article><h2>Total de orientações</h2><strong><%= @orientations.count %></strong><small>em andamento</small></article>
  <article><h2>Alunos ativos</h2><strong><%= @students.count %></strong><small>em acompanhamento</small></article>
  <article><h2>Média de desempenho</h2><strong><%= @students.average(:progress).to_f.round %>%</strong><small>progresso das pesquisas</small></article>
  <article><h2>Atividades em aberto</h2><strong><%= @open_task_count %></strong><small>próximos passos do grupo</small></article>
</section>
<div class="reference-dashboard">
  <section class="lavender-panel upcoming-panel">
    <div class="reference-panel-heading"><h2>Próximas orientações</h2><p>Seus encontros agendados para os próximos dias.</p></div>
    <% if @upcoming.any? %>
      <div class="reference-agenda">
        <% @upcoming.each do |orientation| %>
          <%= link_to orientation_path(orientation), class: "reference-agenda-row" do %>
            <span><strong><%= orientation.student.name %></strong><small><%= l(orientation.next_meeting_at, format: "%d de %b") %> · <%= orientation.student.program %></small></span>
            <span class="reference-agenda-time"><%= portal_icon(:clock) %><%= l(orientation.next_meeting_at, format: "%H:%M") %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state compact"><%= portal_icon(:calendar) %><strong>Nenhuma orientação agendada</strong><p>Defina o próximo encontro no acompanhamento de cada aluno.</p></div>
    <% end %>
    <%= link_to "Ver todas as orientações →", orientations_path, class: "text-link panel-end-link" %>
  </section>
  <section class="lavender-panel suggestions-panel">
    <div class="reference-panel-heading"><h2>Sugestões IA</h2><p>Recursos para apoiar suas orientações.</p></div>
    <div class="reference-suggestion"><h3>Atividades importantes</h3><%= link_to orientations_path, class: "suggestion-bar" do %><span>Organize as próximas entregas do grupo.</span><%= portal_icon(:calendar) %><% end %></div>
    <div class="reference-suggestion"><h3>Planejamento</h3><%= link_to assistant_path, class: "suggestion-bar" do %><span>Conheça o espaço do assistente acadêmico.</span><%= portal_icon(:chat) %><% end %></div>
    <p class="suggestion-note">O assistente de IA está em demonstração.</p>
  </section>
</div>
<div class="dashboard-secondary-grid">
  <section class="panel tasks-panel">
    <div class="panel-heading"><h2>Tarefas em aberto</h2><span class="count-pill"><%= @open_task_count %></span></div>
    <% @pending_tasks.each do |task| %>
      <div class="task-item"><span class="check-ring"></span><div><strong><%= task.title %></strong><small><%= link_to task.orientation.student.name, orientation_path(task.orientation) %></small></div><span class="due-date <%= 'overdue' if task.due_on && task.due_on < Date.current %>"><%= task.due_on ? l(task.due_on, format: "%d %b") : "Sem prazo" %></span></div>
    <% end %>
    <% if @pending_tasks.empty? %><p class="empty-state compact">Tudo em dia. Nenhuma tarefa pendente.</p><% end %>
    <%= link_to "Abrir acompanhamento →", orientations_path, class: "panel-bottom-link" %>
  </section>
  <section class="panel students-panel">
    <div class="panel-heading"><h2>Alunos acompanhados</h2><%= link_to "Ver alunos →", students_path, class: "text-link" %></div>
    <% @students.first(4).each do |student| %>
      <%= link_to student.orientation ? orientation_path(student.orientation) : student_path(student), class: "student-row" do %>
        <div class="avatar"><%= initials(student.name) %></div><div class="student-row-main"><strong><%= student.name %></strong><small><%= student.program %> · <%= student.research_area.presence || "Área a definir" %></small></div><div class="progress-wrap"><div class="progress-track"><span style="width: <%= student.progress %>%"></span></div><small><%= student.progress %>%</small></div>
      <% end %>
    <% end %>
    <% if @students.empty? %><div class="empty-state compact"><p>Cadastre seu primeiro aluno para começar.</p><%= link_to "Cadastrar aluno", new_student_path, class: "text-link" %></div><% end %>
  </section>
</div>
<% if @recent_meetings.any? %>
  <section class="panel recent-panel"><div class="panel-heading"><h2>Registros recentes</h2><%= link_to "Ver orientações →", orientations_path, class: "text-link" %></div>
    <% @recent_meetings.each do |meeting| %><%= link_to orientation_path(meeting.orientation), class: "recent-item" do %><%= portal_icon(:document) %><div><strong><%= meeting.title %></strong><small><%= meeting.orientation.student.name %> · <%= l(meeting.held_at, format: :long) %></small></div><span class="source-tag <%= meeting.source %>"><%= meeting.source == "robot" ? "ROBÔ" : "PORTAL" %></span><% end %><% end %>
  </section>
<% end %>
