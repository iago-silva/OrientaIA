<% content_for :title, "Entrar · PRODUC" %>
<div class="produc-auth-page">
  <section class="produc-auth-intro">
    <div class="auth-cap"><%= portal_icon(:cap) %></div>
    <h1>Portal do <span>Professor</span><br><small>e do Aluno</small></h1>
    <p>Gerencie suas orientações, acompanhe o progresso das pesquisas<br class="desktop-break"> e organize seu conteúdo acadêmico em um só lugar.</p>
    <div class="produc-auth-features">
      <div><%= portal_icon(:book) %><strong>Gestão acadêmica</strong><small>Organize trabalhos e orientações.</small></div>
      <div><%= portal_icon(:user) %><strong>Acompanhamento</strong><small>Monitore o progresso da pesquisa.</small></div>
    </div>
  </section>
  <section class="produc-auth-card" aria-labelledby="login-heading">
    <%= link_to login_path, class: "produc-brand auth-brand" do %><%= portal_icon(:robot, class: "produc-mascot") %><span>PRODUC</span><% end %>
    <h2 id="login-heading">Bem-vindo de volta!</h2><p class="auth-card-description">Acesse seu espaço acadêmico.</p>
    <%= form_with url: login_path, class: "form-stack" do |form| %>
      <div class="field"><%= form.label :email, "Login" %><%= form.email_field :email, placeholder: "E-mail", autocomplete: "username", required: true %></div>
      <div class="field"><%= form.label :password, "Senha" %><%= form.password_field :password, placeholder: "Sua senha", autocomplete: "current-password", required: true %></div>
      <%= form.submit "Entrar", class: "button auth-submit full" %>
    <% end %>
    <p class="auth-switch">Não tem cadastro? <%= link_to "Faça agora!", signup_path %></p>
    <details class="auth-demo"><summary>Conheça as contas de demonstração</summary><p><strong>Aluno</strong><br>marina.costa@orienta.demo<br>Senha: pesquisa2026</p><p><strong>Professor</strong><br>cynara@produc.demo<br>Senha: produc2026</p></details>
  </section>
</div>
